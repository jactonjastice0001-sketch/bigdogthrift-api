# ===================== SERVER =====================
PORT=4000
NODE_ENV=development
# Public base URL of THIS server, no trailing slash. Daraja needs this to reach your callback.
# In development use ngrok (see README), e.g. https://abcd1234.ngrok-free.app
PUBLIC_BASE_URL=https://your-domain-or-ngrok-url.com
# Comma-separated origins allowed to call this API (your storefront domain, localhost while testing)
CORS_ORIGINS=http://localhost:5173,https://your-storefront-domain.com

# ===================== DATABASE (PostgreSQL) =====================
# Create a free Postgres instance on Railway, Render, Neon, or Supabase — or run locally.
DATABASE_URL=postgres://username:password@host:5432/duka_tag
PGSSL=true

# ===================== AUTH =====================
# Long random strings — generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# The seller/vendor account is a single admin login seeded via `npm run seed`
SELLER_EMAIL=owner@dukatag.co.ke
SELLER_PASSWORD=set-a-strong-password-here

# ===================== SAFARICOM DARAJA (M-Pesa) =====================
# Get these from https://developer.safaricom.co.ke -> My Apps
# Start in the Sandbox to test, then apply for Go-Live to move to production + get a real Till/Paybill.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=your-consumer-key
DARAJA_CONSUMER_SECRET=your-consumer-secret
# Sandbox shortcode is 174379 by default; in production this is YOUR till/paybill number
DARAJA_SHORTCODE=174379
# Sandbox passkey is published on the Daraja docs; in production Safaricom issues you one at Go-Live
DARAJA_PASSKEY=your-lipa-na-mpesa-online-passkey
# Where Safaricom will POST the payment result. Must be publicly reachable (see PUBLIC_BASE_URL).
DARAJA_CALLBACK_URL=${PUBLIC_BASE_URL}/api/payments/mpesa/callback

# ===================== FLUTTERWAVE (cards) =====================
# Get these from https://dashboard.flutterwave.com -> Settings -> API Keys
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxx
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxx
# Set this same string as the "Secret Hash" in Flutterwave Dashboard -> Settings -> Webhooks
FLW_WEBHOOK_SECRET_HASH=replace-with-a-random-string
FLW_REDIRECT_URL=${PUBLIC_BASE_URL}/api/payments/flutterwave/redirect

# ===================== TWILIO (SMS) =====================
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# A Twilio phone number capable of sending SMS, in E.164 format
TWILIO_FROM_NUMBER=+254796978358
